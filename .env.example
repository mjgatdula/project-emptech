# Deployment variables for backend.production_settings. Supply real values privately.
# Local backend.settings is left unchanged; no live credentials were copied here.
DJANGO_SETTINGS_MODULE=backend.production_settings
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
JWT_SIGNING_KEY=replace-with-a-different-long-random-secret
DJANGO_ALLOWED_HOSTS=your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
DB_HOST=your-aiven-postgresql-host
DB_PORT=5432
DB_NAME=defaultdb
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_SSLMODE=require
PRIVATE_MEDIA_ROOT=/data/private_media
# Enable only behind a trusted HTTPS reverse proxy:
TRUST_PROXY_HEADERS=false

# Required by the Docker startup command; use the actual reverse proxy address.
TRUSTED_PROXY_IP=replace-with-your-reverse-proxy-ip

# Public OAuth Web Client ID (Google Identity Services uses no client secret).
GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
# Local legacy-login switch; production always uses Google-only website authentication.
ALLOW_PASSWORD_AUTH=false

# Free Render uses a PRIVATE Supabase S3 bucket, never its ephemeral local disk.
# S3 credentials are SERVER-ONLY. Never put these in VITE_* or frontend files.
PRIVATE_STORAGE_BACKEND=s3
PRIVATE_STORAGE_ENDPOINT=https://your-project.storage.supabase.co/storage/v1/s3
PRIVATE_STORAGE_REGION=replace-with-project-region
PRIVATE_STORAGE_BUCKET=tipped-private
PRIVATE_STORAGE_ACCESS_KEY=replace-with-s3-access-key
PRIVATE_STORAGE_SECRET_KEY=replace-with-s3-secret-key
